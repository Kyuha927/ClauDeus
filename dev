#!/usr/bin/env bash
# ClauDeus dev - Bash Entry Point (WSL/Linux)

PYTHON="python3"
if command -v python3.12 >/dev/null 2>&1; then
    PYTHON="python3.12"
fi

case "${1:-}" in
  context-pack|handoff-plan|provider-check|mobile-inbox-check|portfolio-status|skill-suggest|skill-approve)
    $PYTHON tools/dev_v2_cli.py "$@"
    ;;
  *)
    $PYTHON tools/dev_cli.py "$@"
    ;;
esac
